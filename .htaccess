##
# You can use this file to test if mod_rewrite is working correctly.
##
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/(application|system)
    RewriteRule ^(.*)$ public/$1 [L,NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,NC]
</IfModule>

##
# Deny access to sensitive files if the above rewrite fails for any reason
##
<FilesMatch "^\.env">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>
